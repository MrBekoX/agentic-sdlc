{
  "description": "Claude Code hook wiring. Paths use ${CLAUDE_PLUGIN_ROOT}, resolved to this plugin's install directory.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scan-commit.mjs"],
            "if": "Bash(git commit*)",
            "timeout": 20,
            "statusMessage": "Secret scan (commit)..."
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/destructive-command-guard.mjs"],
            "timeout": 15,
            "statusMessage": "Destructive command guard..."
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.mjs"],
            "if": "Bash(git commit*)",
            "timeout": 15,
            "statusMessage": "Branch guard (commit)..."
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.mjs"],
            "if": "Bash(git push*)",
            "timeout": 15,
            "statusMessage": "Branch guard (push)..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/flow-order-guard.mjs"],
            "timeout": 15,
            "statusMessage": "Flow-order guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scan-write.mjs"],
            "timeout": 15,
            "statusMessage": "Secret scan (write)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/completion-claim-guard.mjs"],
            "timeout": 15,
            "statusMessage": "Completion-claim guard..."
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/flow-step-guard.mjs"],
            "timeout": 30,
            "statusMessage": "Flow-step guard..."
          }
        ]
      }
    ]
  }
}
