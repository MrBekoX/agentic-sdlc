{
  "version": 1,
  "$comment": "Single source for runtime flow-step enforcement. Consumed by the live hooks (flow-step-guard.mjs on Stop, flow-order-guard.mjs on PreToolUse) and asserted by the offline gate. Evidence is ALWAYS re-derived from observable facts (artifact file re-validated by validate_artifacts.py / a real tool_use event / a real command in the transcript), never trusted from the agent's prose.",
  "sourceGlobs": [
    "py", "js", "mjs", "cjs", "ts", "tsx", "jsx", "go", "rs", "java", "rb",
    "php", "c", "cc", "cpp", "h", "hpp", "cs", "kt", "swift", "scala", "m"
  ],
  "artifactRoots": {
    "spec": "docs/agentic-sdlc/specs",
    "plan": "docs/agentic-sdlc/plans"
  },
  "perPackageArtifact": {
    "base": "docs/agentic-sdlc",
    "subdirs": { "spec": "spec", "plan": "plan" },
    "slugPattern": "^[a-z0-9][a-z0-9-]{0,63}$",
    "reservedSlugs": ["specs", "plans", "evidence", "notes", "spec", "plan"]
  },
  "testCommand": "\\b(pytest|unittest|jest|vitest|mocha|go\\s+test|cargo\\s+test|rspec|phpunit|gradle\\s+test|mvn\\s+test|make\\s+test|npm\\s+(?:run\\s+)?test|yarn\\s+test|pnpm\\s+(?:run\\s+)?test|tox|nox)\\b",
  "completionClaim": "\\b(all\\s+tests?\\s+(pass|passing|green)|all\\s+green|ready\\s+to\\s+(merge|ship)|implementation\\s+(is\\s+)?complete|feature\\s+complete|task\\s+(is\\s+)?complete|done\\s+and\\s+verified|fixed\\s+and\\s+verified|everything\\s+(works|passes))\\b",
  "flows": {
    "root-cause-fix": {
      "activeWhen": { "skill": "root-cause-fix" },
      "steps": [
        {
          "id": "spec",
          "label": "Spec (WHAT)",
          "evidence": [
            { "kind": "artifact", "role": "spec", "validate": { "mode": "spec", "strict": true } },
            { "kind": "toolUse", "tool": "Workflow", "contains": "spec-plan-draft" },
            { "kind": "toolUse", "tool": "Agent", "contains": "spec-plan-author" }
          ],
          "stop": "block",
          "beforeSourceEdit": true
        },
        {
          "id": "plan",
          "label": "Plan (HOW)",
          "evidence": [
            { "kind": "artifact", "role": "plan", "validate": { "mode": "plan", "strict": true } },
            { "kind": "toolUse", "tool": "Workflow", "contains": "spec-plan-draft" }
          ],
          "stop": "block",
          "beforeSourceEdit": true
        },
        {
          "id": "tests",
          "label": "RED to GREEN tests run",
          "evidence": [
            { "kind": "command", "matches": "testCommand" }
          ],
          "stop": "block",
          "beforeSourceEdit": false
        },
        {
          "id": "security",
          "label": "Security analysis",
          "evidence": [
            { "kind": "toolUse", "tool": "Skill", "contains": "security-audit" },
            { "kind": "toolUse", "tool": "Agent", "contains": "security-reviewer" }
          ],
          "stop": "warn",
          "beforeSourceEdit": false
        },
        {
          "id": "control",
          "label": "Implementation control",
          "evidence": [
            { "kind": "toolUse", "tool": "Skill", "contains": "implementation-control" },
            { "kind": "toolUse", "tool": "Agent", "contains": "implementation-auditor" }
          ],
          "stop": "block",
          "beforeSourceEdit": false
        },
        { "id": "branch", "label": "Source edits off protected branch", "evidence": [ { "kind": "branch" } ], "stop": "warn", "beforeSourceEdit": false },
        { "id": "review-result", "label": "Reviewer results returned without error", "evidence": [ { "kind": "reviewResult", "reviewers": { "control": [ { "tool": "Skill", "contains": "implementation-control" }, { "tool": "Agent", "contains": "implementation-auditor" } ], "security": [ { "tool": "Skill", "contains": "security-audit" }, { "tool": "Agent", "contains": "security-reviewer" } ] } } ], "stop": "warn", "beforeSourceEdit": false }
      ]
    },
    "feature-build": {
      "activeWhen": { "skill": "feature-build" },
      "steps": [
        { "id": "spec", "label": "Spec (WHAT)", "evidence": [ { "kind": "artifact", "role": "spec", "validate": { "mode": "spec", "strict": true } }, { "kind": "toolUse", "tool": "Workflow", "contains": "spec-plan-draft" }, { "kind": "toolUse", "tool": "Agent", "contains": "spec-plan-author" } ], "stop": "block", "beforeSourceEdit": true },
        { "id": "plan", "label": "Plan (HOW)", "evidence": [ { "kind": "artifact", "role": "plan", "validate": { "mode": "plan", "strict": true } }, { "kind": "toolUse", "tool": "Workflow", "contains": "spec-plan-draft" } ], "stop": "block", "beforeSourceEdit": true },
        { "id": "tests", "label": "RED to GREEN tests run", "evidence": [ { "kind": "command", "matches": "testCommand" } ], "stop": "block", "beforeSourceEdit": false },
        { "id": "security", "label": "Security analysis", "evidence": [ { "kind": "toolUse", "tool": "Skill", "contains": "security-audit" }, { "kind": "toolUse", "tool": "Agent", "contains": "security-reviewer" } ], "stop": "warn", "beforeSourceEdit": false },
        { "id": "control", "label": "Implementation control", "evidence": [ { "kind": "toolUse", "tool": "Skill", "contains": "implementation-control" }, { "kind": "toolUse", "tool": "Agent", "contains": "implementation-auditor" } ], "stop": "block", "beforeSourceEdit": false },
        { "id": "branch", "label": "Source edits off protected branch", "evidence": [ { "kind": "branch" } ], "stop": "warn", "beforeSourceEdit": false },
        { "id": "review-result", "label": "Reviewer results returned without error", "evidence": [ { "kind": "reviewResult", "reviewers": { "control": [ { "tool": "Skill", "contains": "implementation-control" }, { "tool": "Agent", "contains": "implementation-auditor" } ], "security": [ { "tool": "Skill", "contains": "security-audit" }, { "tool": "Agent", "contains": "security-reviewer" } ] } } ], "stop": "warn", "beforeSourceEdit": false }
      ]
    },
    "safe-refactor": {
      "activeWhen": { "skill": "safe-refactor" },
      "steps": [
        { "id": "characterization", "label": "Characterization tests (safety net) run", "evidence": [ { "kind": "command", "matches": "testCommand" } ], "stop": "block", "beforeSourceEdit": true },
        { "id": "control", "label": "Implementation control", "evidence": [ { "kind": "toolUse", "tool": "Skill", "contains": "implementation-control" }, { "kind": "toolUse", "tool": "Agent", "contains": "implementation-auditor" } ], "stop": "block", "beforeSourceEdit": false },
        { "id": "branch", "label": "Source edits off protected branch", "evidence": [ { "kind": "branch" } ], "stop": "warn", "beforeSourceEdit": false },
        { "id": "review-result", "label": "Reviewer results returned without error", "evidence": [ { "kind": "reviewResult", "reviewers": { "control": [ { "tool": "Skill", "contains": "implementation-control" }, { "tool": "Agent", "contains": "implementation-auditor" } ] } } ], "stop": "warn", "beforeSourceEdit": false }
      ]
    },
    "agentic-sdlc-pipeline": {
      "$comment": "Activation: when the pipeline skill is invoked through the Skill tool (exact name, bare or agentic-sdlc: prefixed), or started as a slash command: flow-evidence.mjs reads the top-level user record that opens, after optional whitespace, with <command-message> or <command-name> and names <command-name>/agentic-sdlc-pipeline</command-name> or /agentic-sdlc:agentic-sdlc-pipeline (the shape captured in headless claude -p on Claude Code 2.1.302; an interactive-session start was not captured). The offline procedure-eval (tests/skills/procedure/agentic-sdlc-pipeline.json) still grades the full run. The pipeline never invokes the focused skills (feature-build, root-cause-fix, safe-refactor, test-authoring, security-audit, implementation-control): it reads the selected work-type core file, calls dispatch-strategy once at kickoff, before Step 1, and dispatches the security-reviewer and implementation-auditor agents directly, so those steps match exact names (exactName). red-first carries no stop key, so it gates only the first production edit and never joins the Codex Stop gate; whether that run failed, and the step order, are checked by the offline strict grader. Codex emits no Skill/Agent transcript events and is covered by the offline strict grader (scripts/run_procedure_eval.py --strict-evidence).",
      "activeWhen": { "skill": "agentic-sdlc-pipeline" },
      "steps": [
        { "id": "dispatch", "label": "Mechanism decision (dispatch-strategy)", "evidence": [ { "kind": "toolUse", "tool": "Skill", "exactName": "dispatch-strategy" } ], "stop": "block", "beforeSourceEdit": true },
        { "id": "spec", "label": "Spec (WHAT)", "evidence": [ { "kind": "artifact", "role": "spec", "validate": { "mode": "spec", "strict": true } }, { "kind": "toolUse", "tool": "Workflow", "contains": "spec-plan-draft" }, { "kind": "toolUse", "tool": "Agent", "contains": "spec-plan-author" } ], "stop": "block", "beforeSourceEdit": true },
        { "id": "plan", "label": "Plan (HOW)", "evidence": [ { "kind": "artifact", "role": "plan", "validate": { "mode": "plan", "strict": true } }, { "kind": "toolUse", "tool": "Workflow", "contains": "spec-plan-draft" } ], "stop": "block", "beforeSourceEdit": true },
        { "id": "red-first", "label": "Test command run before the first production edit", "evidence": [ { "kind": "command", "matches": "testCommand" } ], "beforeSourceEdit": true },
        { "id": "tests", "label": "RED to GREEN tests run", "evidence": [ { "kind": "command", "matches": "testCommand" } ], "stop": "block", "beforeSourceEdit": false },
        { "id": "security", "label": "Security analysis", "evidence": [ { "kind": "toolUse", "tool": "Agent", "exactName": "security-reviewer" } ], "stop": "block", "beforeSourceEdit": false },
        { "id": "control", "label": "Implementation control", "evidence": [ { "kind": "toolUse", "tool": "Agent", "exactName": "implementation-auditor" } ], "stop": "block", "beforeSourceEdit": false },
        { "id": "branch", "label": "Source edits off protected branch", "evidence": [ { "kind": "branch" } ], "stop": "warn", "beforeSourceEdit": false },
        { "id": "review-result", "label": "Reviewer results returned without error", "evidence": [ { "kind": "reviewResult", "reviewers": { "control": [ { "tool": "Agent", "exactName": "implementation-auditor" } ], "security": [ { "tool": "Agent", "exactName": "security-reviewer" } ] } } ], "stop": "warn", "beforeSourceEdit": false }
      ]
    }
  }
}
