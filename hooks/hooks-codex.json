{
  "description": "Codex hook wiring for the supported compatibility manifest. Paths use ${PLUGIN_ROOT}, resolved to the installed plugin directory. Commands are single shell strings, not args arrays. Non-managed hooks require review/trust; see docs/runtime-adapter.md for current discovery, execution evidence, and parser limits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scan-commit.mjs\"",
            "timeout": 20,
            "statusMessage": "Secret scan (commit)..."
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/destructive-command-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Destructive command guard..."
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/branch-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Branch guard (commit/push)..."
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scan-write-codex.mjs\"",
            "timeout": 20,
            "statusMessage": "Secret scan (write)..."
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flow-order-guard-codex.mjs\"",
            "timeout": 20,
            "statusMessage": "Flow-order gate (codex)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start-codex.mjs\"",
            "timeout": 15,
            "statusMessage": "AGENTIC-SDLC startup context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/completion-claim-guard-codex.mjs\"",
            "timeout": 20,
            "statusMessage": "Completion-claim gate (marker)..."
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flow-step-guard-codex.mjs\"",
            "timeout": 20,
            "statusMessage": "Flow-step evidence gate (codex)..."
          }
        ]
      }
    ]
  }
}
