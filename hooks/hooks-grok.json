{
  "description": "Grok CLI command guards. Fixed Node launchers read GROK_PLUGIN_ROOT as data. Requires Node on the selected shell PATH; keeps unverified write, Stop and startup adapters unwired.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.GROK_PLUGIN_ROOT,'hooks','scan-commit.mjs');process.argv[1]=p;import(require('node:url').pathToFileURL(p).href)\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.GROK_PLUGIN_ROOT,'hooks','destructive-command-guard.mjs');process.argv[1]=p;import(require('node:url').pathToFileURL(p).href)\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.GROK_PLUGIN_ROOT,'hooks','branch-guard.mjs');process.argv[1]=p;import(require('node:url').pathToFileURL(p).href)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
