{
  "$comment": "Design §5.15: strategy -> context -> draft(spec+plan) -> review(gate; absent in light) -> branch -> implement -> security -> audit -> claim.",
  "schema": "agentic-sdlc/flow@1",
  "id": "feature",
  "entry_skill": "feature-build",
  "forms": ["gated", "light"],
  "work_types": ["feature"],
  "loop_mode": "spec+plan",
  "steps": [
    {
      "id": "strategy",
      "file": "skills/dispatch-strategy/steps/strategy.md",
      "inputs": ["@start"],
      "outputs": ["strategy.json"],
      "done_when": [{"check": "strategy_ok"}],
      "run_once": true,
      "max_visits": 1
    },
    {
      "id": "context",
      "file": "skills/agentic-sdlc-pipeline/steps/context.md",
      "inputs": ["request.md"],
      "outputs": ["context.md"],
      "done_when": [{"check": "report", "path": "context.md", "header": "## Scope Lock"}],
      "mechanism_key": "context"
    },
    {
      "id": "draft",
      "file": "skills/plan-authoring/steps/draft.md",
      "inputs": ["request.md", "context.md", "feedback.jsonl?"],
      "outputs": ["spec/{work_id}.md", "spec/{work_id}.review.json", "plan/{work_id}.md", "plan/{work_id}.review.json"],
      "done_when": [
        {"check": "loop_done"},
        {"check": "validator", "mode": "spec", "strict": false},
        {"check": "sidecar_ok", "artifact": "spec"},
        {"check": "validator", "mode": "plan", "strict": true},
        {"check": "sidecar_ok", "artifact": "plan"}
      ],
      "mechanism_key": "draft",
      "loop": "spec-plan"
    },
    {
      "id": "review",
      "file": "skills/agentic-sdlc-pipeline/steps/review.md",
      "inputs": ["spec/{work_id}.md#body", "plan/{work_id}.md#body"],
      "outputs": [],
      "done_when": [{"check": "approval", "gate": "review"}],
      "gate": "review",
      "applies_when": {"form": "gated"}
    },
    {
      "id": "branch",
      "file": "skills/agentic-sdlc-pipeline/steps/branch.md",
      "inputs": [],
      "outputs": [],
      "done_when": [{"check": "branch_ok"}],
      "may_ask": ["consent"]
    },
    {
      "id": "implement",
      "file": {"feature": "skills/feature-build/steps/implement.md"},
      "inputs": ["spec/{work_id}.md#body", "plan/{work_id}.md#body"],
      "outputs": ["evidence/{work_id}.tdd.md"],
      "done_when": [
        {"check": "run_recorded", "expect": "fail", "label": "red"},
        {"check": "run_recorded", "expect": "pass", "label": "green"},
        {"check": "report", "path": "evidence/{work_id}.tdd.md", "header": "# TDD evidence"}
      ],
      "max_visits": 5,
      "mechanism_key": "implement"
    },
    {
      "id": "security",
      "file": "skills/security-audit/steps/security.md",
      "inputs": ["@source"],
      "outputs": ["evidence/{work_id}.security.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.security.md", "header": "# Security review", "verdict": "Verdict: pass"}],
      "mechanism_key": "security"
    },
    {
      "id": "audit",
      "file": "skills/implementation-control/steps/audit.md",
      "inputs": ["@source", "@tests", "plan/{work_id}.md#body"],
      "outputs": ["evidence/{work_id}.audit.md"],
      "done_when": [
        {"check": "resolver_ok"},
        {"check": "run_recorded", "expect": "pass", "label": "green"},
        {"check": "report", "path": "evidence/{work_id}.audit.md", "header": "# Implementation audit"}
      ],
      "mechanism_key": "audit"
    },
    {
      "id": "claim",
      "file": "skills/completion-claim-gate/steps/claim.md",
      "inputs": ["@source", "@tests"],
      "outputs": ["evidence/{work_id}.claim.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.claim.md", "header": "# Completion claim"}]
    }
  ]
}
