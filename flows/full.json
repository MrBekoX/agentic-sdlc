{
  "$comment": "Design §5.15: strategy -> context -> [intent] -> draft(spec+plan) -> review(gate) -> branch -> [docs-check] -> implement -> security -> [quality-gates] -> diff-review -> [quality-review] -> audit -> claim. Gated only (design §5.3).",
  "schema": "agentic-sdlc/flow@1",
  "id": "full",
  "entry_skill": "agentic-sdlc-pipeline",
  "forms": ["gated"],
  "work_types": ["feature", "bugfix", "refactor"],
  "loop_mode": "spec+plan",
  "steps": [
    {
      "id": "strategy",
      "file": "skills/dispatch-strategy/steps/strategy.md",
      "inputs": ["@start"],
      "outputs": ["strategy.json"],
      "done_when": [{"check": "strategy_ok"}],
      "run_once": true,
      "max_visits": 1
    },
    {
      "id": "context",
      "file": "skills/agentic-sdlc-pipeline/steps/context.md",
      "inputs": ["request.md"],
      "outputs": ["context.md"],
      "done_when": [{"check": "report", "path": "context.md", "header": "## Scope Lock"}],
      "mechanism_key": "context"
    },
    {
      "id": "intent",
      "file": "skills/mind-spark/steps/intent.md",
      "inputs": ["request.md", "context.md"],
      "outputs": ["design.md"],
      "done_when": [{"check": "exists", "path": "design.md"}],
      "applies_when": {"option": "intent"},
      "may_ask": ["design"]
    },
    {
      "id": "draft",
      "file": "skills/plan-authoring/steps/draft.md",
      "inputs": ["request.md", "context.md", "design.md?", "feedback.jsonl?"],
      "outputs": ["spec/{work_id}.md", "spec/{work_id}.review.json", "plan/{work_id}.md", "plan/{work_id}.review.json"],
      "done_when": [
        {"check": "loop_done"},
        {"check": "validator", "mode": "spec", "strict": false},
        {"check": "sidecar_ok", "artifact": "spec"},
        {"check": "validator", "mode": "plan", "strict": true},
        {"check": "sidecar_ok", "artifact": "plan"}
      ],
      "mechanism_key": "draft",
      "loop": "spec-plan"
    },
    {
      "id": "review",
      "file": "skills/agentic-sdlc-pipeline/steps/review.md",
      "inputs": ["spec/{work_id}.md#body", "plan/{work_id}.md#body"],
      "outputs": [],
      "done_when": [{"check": "approval", "gate": "review"}],
      "gate": "review"
    },
    {
      "id": "branch",
      "file": "skills/agentic-sdlc-pipeline/steps/branch.md",
      "inputs": [],
      "outputs": [],
      "done_when": [{"check": "branch_ok"}],
      "may_ask": ["consent"]
    },
    {
      "id": "docs-check",
      "file": "skills/agentic-sdlc-pipeline/steps/docs-check.md",
      "inputs": ["plan/{work_id}.md#body"],
      "outputs": ["evidence/{work_id}.docs.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.docs.md", "header": "# Docs check"}],
      "applies_when": {"probe": "deps", "not": "stdlib_only"},
      "may_ask": ["consent"],
      "mechanism_key": "docs-check"
    },
    {
      "id": "implement",
      "file": {
        "feature": "skills/feature-build/steps/implement.md",
        "bugfix": "skills/root-cause-fix/steps/implement.md",
        "refactor": "skills/safe-refactor/steps/implement.md"
      },
      "inputs": ["spec/{work_id}.md#body", "plan/{work_id}.md#body"],
      "outputs": ["evidence/{work_id}.tdd.md"],
      "$comment": "The refactor variant uses safe-refactor's step file, which takes no RED (a behaviour-preserving change has no failing test; its Goal Lock is the ## Goal Lock section of context.md, design §5.15), so the RED check applies to feature and bugfix work only.",
      "done_when": [
        {"check": "run_recorded", "expect": "fail", "label": "red", "work_types": ["feature", "bugfix"]},
        {"check": "run_recorded", "expect": "pass", "label": "green"},
        {"check": "report", "path": "evidence/{work_id}.tdd.md", "header": "# TDD evidence"}
      ],
      "max_visits": 5,
      "mechanism_key": "implement"
    },
    {
      "id": "security",
      "file": "skills/security-audit/steps/security.md",
      "inputs": ["@source"],
      "outputs": ["evidence/{work_id}.security.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.security.md", "header": "# Security review", "verdict": "Verdict: pass"}],
      "mechanism_key": "security"
    },
    {
      "id": "quality-gates",
      "file": "skills/agentic-sdlc-pipeline/steps/quality-gates.md",
      "inputs": ["@source", "@tests"],
      "outputs": ["evidence/{work_id}.gates.md"],
      "done_when": [
        {"check": "run_recorded", "expect": "pass", "label": "check"},
        {"check": "report", "path": "evidence/{work_id}.gates.md", "header": "# Quality gates"}
      ],
      "applies_when": {"probe": "toolchain", "not": "absent"},
      "mechanism_key": "quality-gates"
    },
    {
      "id": "diff-review",
      "file": "skills/agentic-sdlc-pipeline/steps/diff-review.md",
      "inputs": ["@diff"],
      "outputs": ["evidence/{work_id}.diff.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.diff.md", "header": "# Diff review"}]
    },
    {
      "id": "quality-review",
      "file": "skills/code-quality-review/steps/quality-review.md",
      "inputs": ["@source", "@tests"],
      "outputs": ["evidence/{work_id}.quality.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.quality.md", "header": "# Quality review"}],
      "applies_when": {"option": "quality-review"},
      "mechanism_key": "quality-review"
    },
    {
      "id": "audit",
      "file": "skills/implementation-control/steps/audit.md",
      "inputs": ["@source", "@tests", "plan/{work_id}.md#body"],
      "outputs": ["evidence/{work_id}.audit.md"],
      "done_when": [
        {"check": "resolver_ok"},
        {"check": "run_recorded", "expect": "pass", "label": "green"},
        {"check": "report", "path": "evidence/{work_id}.audit.md", "header": "# Implementation audit"}
      ],
      "mechanism_key": "audit"
    },
    {
      "id": "claim",
      "file": "skills/completion-claim-gate/steps/claim.md",
      "inputs": ["@source", "@tests"],
      "outputs": ["evidence/{work_id}.claim.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.claim.md", "header": "# Completion claim"}]
    }
  ]
}
