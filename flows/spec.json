{
  "$comment": "Hybrid spec/plan design §3: strategy -> context -> intent -> spec -> spec-check -> spec-review -> claim. Gated only, so no step carries a form. Under start --option loop the loop's draft(spec) -> review run in place of spec, spec-check and spec-review.",
  "schema": "agentic-sdlc/flow@1",
  "id": "spec",
  "entry_skill": "spec-authoring",
  "forms": ["gated"],
  "work_types": ["feature", "bugfix", "refactor", "test"],
  "loop_mode": "spec",
  "steps": [
    {
      "id": "strategy",
      "file": "skills/dispatch-strategy/steps/strategy.md",
      "inputs": ["@start"],
      "outputs": ["strategy.json"],
      "done_when": [{"check": "strategy_ok"}],
      "run_once": true,
      "max_visits": 1
    },
    {
      "id": "context",
      "file": "skills/agentic-sdlc-pipeline/steps/context.md",
      "inputs": ["request.md"],
      "outputs": ["context.md"],
      "done_when": [{"check": "report", "path": "context.md", "header": "## Scope Lock"}],
      "mechanism_key": "context"
    },
    {
      "id": "intent",
      "file": "skills/mind-spark/steps/intent.md",
      "inputs": ["request.md", "context.md"],
      "outputs": ["design.md"],
      "done_when": [{"check": "validator", "mode": "design"}],
      "may_ask": ["design"]
    },
    {
      "id": "draft",
      "file": "skills/spec-authoring/steps/draft.md",
      "inputs": ["request.md", "context.md", "design.md?", "feedback.jsonl?"],
      "outputs": ["spec/{work_id}.md", "spec/{work_id}.review.json"],
      "done_when": [
        {"check": "loop_done"},
        {"check": "validator", "mode": "spec", "strict": false},
        {"check": "sidecar_ok", "artifact": "spec"}
      ],
      "applies_when": {"option": "loop"},
      "mechanism_key": "draft",
      "loop": "spec-plan"
    },
    {
      "id": "review",
      "file": "skills/agentic-sdlc-pipeline/steps/review.md",
      "inputs": ["spec/{work_id}.md#body"],
      "outputs": [],
      "done_when": [{"check": "approval", "gate": "review"}],
      "gate": "review",
      "applies_when": {"option": "loop"}
    },
    {
      "id": "spec",
      "file": "skills/spec-authoring/steps/spec.md",
      "inputs": ["request.md", "context.md", "design.md"],
      "outputs": ["spec/{work_id}.md"],
      "done_when": [{"check": "validator", "mode": "spec", "strict": false, "sources": true}],
      "applies_when": {"not_option": "loop"}
    },
    {
      "id": "spec-check",
      "file": "skills/spec-authoring/steps/spec-check.md",
      "inputs": ["design.md"],
      "outputs": ["spec/{work_id}.check.json"],
      "done_when": [{"check": "settled"}],
      "applies_when": {"not_option": "loop"},
      "mechanism_key": "spec-check",
      "role": "spec-builder-check",
      "role_reads": ["design.md", "spec/{work_id}.md"],
      "may_ask": ["design"]
    },
    {
      "id": "spec-review",
      "file": "skills/agentic-sdlc-pipeline/steps/spec-review.md",
      "inputs": ["design.md#body", "spec/{work_id}.md#body"],
      "outputs": [],
      "done_when": [{"check": "approval", "gate": "spec-review"}],
      "gate": "spec-review",
      "applies_when": {"not_option": "loop"}
    },
    {
      "id": "claim",
      "file": "skills/completion-claim-gate/steps/claim.md",
      "inputs": ["spec/{work_id}.md#body"],
      "outputs": ["evidence/{work_id}.claim.md"],
      "done_when": [{"check": "report", "path": "evidence/{work_id}.claim.md", "header": "# Completion claim"}]
    }
  ]
}
