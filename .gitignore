# Node
node_modules/

# Test artifacts / generated eval outputs — never the tracked fixtures/evals/source.
# Live trigger/procedure/behavior eval runs write here (matrices, transcripts, reruns).
tests/artifacts/
tests/**/__pycache__/

# Documentation: track plugin docs; keep generated audit reports local unless intentionally added.
docs/*
docs/codex-plugin-runtime-debug-report/
