docs/agentic-sdlc/*
!docs/agentic-sdlc/evidence/
docs/agentic-sdlc/evidence/*
!docs/agentic-sdlc/evidence/codex-live-low-strict-2026-06-20.md
# Model-generated audit write-ups stay local; never distributed.
audit-docs/
# Maintainer prompt and plan inputs for agent sessions; local only, never distributed.
agentic-sdlc-prompts/
# Contract test for a prompt in agentic-sdlc-prompts/; it reads that folder, so it can only
# run where the folder exists and must stay out of clean clones and CI.
tests/test_superpowers_referenced_eval_prompt.py

# Debug / local runtime artifacts
# Local agent-tool state; plugin_root holds this machine's absolute path.
.video_agent/
debug.txt
# Dated local debug dumps at the repository root (YYYY-MM-DD-HHMMSS-<topic>.txt).
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Optional tool reference snapshots
mcps/

# Claude Code local / runtime
.claude/
# Codex local workspace and code-index caches (per-machine tool state, not distributed)
.codex/
.codegraph/
# ZCode local workspace. NOT .grok/: that is the project workflow catalog Grok loads from the
# repo (.grok/workflows/*.rhai), so it is tracked and shared. ZCode publishes no such catalog
# path, and an untracked .zcode/ copy of a tracked workflow silently drifted once already.
.zcode/
# OpenCode local tool workspace (node_modules + config; local tooling, not distributed)
.opencode/
# Omo local run-continuation state (per-session tool state, not distributed)
.omo/
settings.local.json
scheduled_tasks.lock
.handoffs/
.sdd/
.worktrees/
.tmp-superpowers-compare/
_tmp_superpowers_benchmark/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build / dist
dist/
build/

# Agent operating model (local; not distributed with the plugin)
AGENTS.md
CLAUDE.md
