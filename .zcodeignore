# run where the folder exists and must stay out of clean clones and CI.
tests/test_superpowers_referenced_eval_prompt.py

# Debug / local runtime artifacts
# Local agent-tool state; plugin_root holds this machine's absolute path.
.video_agent/
debug.txt
2026-06-21-161126-sessionstartstartup-hook-error.txt
