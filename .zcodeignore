2026-06-24-155430-grev.txt

# Optional tool reference snapshots
mcps/

# Claude Code local / runtime
.claude/
# ZCode local workspace. NOT .grok/: that is the project workflow catalog Grok loads from the
# repo (.grok/workflows/*.rhai), so it is tracked and shared. ZCode publishes no such catalog
# path, and an untracked .zcode/ copy of a tracked workflow silently drifted once already.
.zcode/
# OpenCode local tool workspace (node_modules + config; local tooling, not distributed)
.opencode/
# Omo local run-continuation state (per-session tool state, not distributed)
.omo/
settings.local.json
scheduled_tasks.lock
.handoffs/
.sdd/
.worktrees/
.tmp-superpowers-compare/
_tmp_superpowers_benchmark/

